# Base URL for the application
BASE_URL=https://kto-cms-ecru.vercel.app/

# API base URL for API tests
API_BASE_URL=https://api.kto.solutions

# Alternative environments (uncomment as needed)
# BASE_URL_DEV=http://localhost:3000
# BASE_URL_STAGING=https://staging.kto-cms.vercel.app/
# BASE_URL_PROD=https://kto-cms-ecru.vercel.app/

# Test user credentials
TEST_USERNAME=your_username
TEST_PASSWORD=your_password

# Other configuration
HEADLESS=true

# k6 performance tests (see k6/README.md)
# K6_TEST_TYPE=load
# LOAD_VUS=50
# LOAD_DURATION=5m
# STRESS_MAX_VUS=200
# SPIKE_VUS=100
# SOAK_VUS=30
# SOAK_DURATION=30m
# APDEX_T=500
# APDEX_TOLERATING=2000
